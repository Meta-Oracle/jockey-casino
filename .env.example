# Jockey Casino env — copy to .env.local and Vercel project settings

# REQUIRED: your Solana wallet — all in-game spends + PvP buy-ins land here
NEXT_PUBLIC_TREASURY_WALLET=

# OPTIONAL but needed for automatic winner payouts (base58 secret OR JSON byte array)
# Must be the private key for the same treasury wallet above.
# Keep this SERVER-ONLY — never prefix with NEXT_PUBLIC_
TREASURY_PRIVATE_KEY=

# OPTIONAL: dedicated RPC (Helius / QuickNode recommended for mainnet)
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com

# OPTIONAL: Upstash Redis — required for reliable PvP lobbies on multi-instance Vercel
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
